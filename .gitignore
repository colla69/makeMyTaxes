target/

# Personal facts for Claude, the private scan terms and the local scan tool.
CLAUDE.local.md
.privacy/

# Real tax data must never enter the repository.
*.db
*.db-journal
*.db-wal
*.db-shm

# The data and the passphrase of the live container.
deploy/data/*
!deploy/data/.gitkeep
deploy/.env

# The data and the passphrase of the dev container. It holds made-up test data only.
deploy/data-dev/*
!deploy/data-dev/.gitkeep
deploy/.env.dev

# The law library is rebuilt from law/sources.tsv
law/text/

# The form instructions are downloaded by hand and checked against law/guidance.tsv
law/guidance/

# IDE settings
.idea/

# Decision records stay on the owner's machine
docs/adr/
