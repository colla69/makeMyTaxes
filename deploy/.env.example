# Copy this file to deploy/.env and run "chmod 600 deploy/.env". Git ignores deploy/.env.
# Keep the single quotes. Without them, Docker Compose changes a passphrase that has a $ in it.
MAKEMYTAXES_DATABASE_PASSPHRASE='change-this-passphrase'
# The Claude Code program on the host, for the assistant. Without it, the assistant is not available.
# The value must be the program itself, not a wrapper script: "file -L <path>" must show an ELF executable.
# A wrapper script such as /usr/bin/claude starts the program at another path, and that path does not
# exist in the container.
# The dev container reads deploy/.env.dev, so set it there too.
# MAKEMYTAXES_CLAUDE_CODE=/opt/claude-code/bin/claude
